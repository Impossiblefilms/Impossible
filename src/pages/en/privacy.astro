---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company } from '../../lib/company';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<BaseLayout lang="en" title={t('legal.privacy.title')}>
  <section class="mx-auto max-w-2xl px-6 pb-24 pt-40 font-body text-paper-200 md:px-10">
    <h1 class="font-display uppercase text-paper-50" style="font-size: var(--text-h2);">
      {t('legal.privacy.title')}
    </h1>
    <div class="mt-10 space-y-8 text-sm leading-relaxed">
      <div>
        <h2 class="mb-2 text-xs uppercase tracking-wide text-paper-400">1. Controller</h2>
        <p>
          {company.name}<br />
          {company.street}, {company.postalCode} {company.city}<br />
          Email: {company.email}<br />
          Phone: {company.phone}
        </p>
      </div>

      <div>
        <h2 class="mb-2 text-xs uppercase tracking-wide text-paper-400">2. General information</h2>
        <p>
          We generally only process personal data of our users to the extent necessary to provide a
          functioning website along with our content and services.
        </p>
      </div>

      <div>
        <h2 class="mb-2 text-xs uppercase tracking-wide text-paper-400">3. Hosting</h2>
        <p>
          This website is hosted by Hostinger. When you access the website, the hosting provider
          automatically collects so-called server log files transmitted by your browser (including IP
          address, date/time of the request, page requested, browser used). This data is technically
          necessary to deliver the website securely and reliably, and is not combined with other data
          sources.
        </p>
      </div>

      <div>
        <h2 class="mb-2 text-xs uppercase tracking-wide text-paper-400">4. Cookies</h2>
        <p>
          This website does not currently use tracking or marketing cookies. Should this change (e.g.
          through analytics tools), this notice will be updated and a consent banner will be added.
        </p>
      </div>

      <div>
        <h2 class="mb-2 text-xs uppercase tracking-wide text-paper-400">5. Embedded videos (Vimeo)</h2>
        <p>
          To display our projects, we embed videos from Vimeo (Vimeo Inc., 555 West 18th Street, New
          York, USA). The Vimeo player is <strong>not</strong> loaded automatically when the page is opened —
          it is initially shown only as a preview image. Only once you actively click the play button
          is a connection established to Vimeo's servers, transmitting data (including your IP
          address) to Vimeo. For more information, see{' '}
          <a href="https://vimeo.com/privacy" target="_blank" rel="noopener noreferrer" class="text-paper-50 underline hover:text-paper-400">Vimeo's privacy policy</a>.
        </p>
      </div>

      <div>
        <h2 class="mb-2 text-xs uppercase tracking-wide text-paper-400">6. Web fonts</h2>
        <p>
          This website uses web fonts for consistent typography. All fonts used are hosted locally on
          our own server — there is no connection to external font providers (such as Google Fonts),
          so no data is transmitted to third parties for this purpose.
        </p>
      </div>

      <div>
        <h2 class="mb-2 text-xs uppercase tracking-wide text-paper-400">7. Contacting us</h2>
        <p>
          When you contact us by email, the data you provide (including your email address, and
          optionally your name and phone number) will be stored in order to process your inquiry.
        </p>
      </div>

      <div>
        <h2 class="mb-2 text-xs uppercase tracking-wide text-paper-400">8. Your rights</h2>
        <p>
          You have the right to access, rectify, erase and restrict the processing of your personal
          data, as well as a right to object to processing and a right to data portability. You also
          have the right to lodge a complaint with a data protection supervisory authority.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
