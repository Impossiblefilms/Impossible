---
import { languages } from '../../i18n/ui';
import { translatePath, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="flex items-center gap-1 font-body text-xs tracking-wide">
  {
    Object.entries(languages).map(([code, label]) => {
      const isActive = code === lang;
      const href = isActive ? currentPath : translatePath(currentPath, code as Locale);
      return (
        <a
          href={href}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'px-1.5 py-1 transition-colors',
            isActive ? 'text-paper-50' : 'text-paper-400 hover:text-paper-50',
          ]}
        >
          {label}
        </a>
      );
    })
  }
</div>
