---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;

// Left-to-right reading order of the "IMPOSSIBLE" vector paths, taken from
// the source logo (public/logo/impossible-wordmark-source.svg). The strike
// line is kept separate and rendered last, both in the DOM (so it paints on
// top of the letters) and in the animation (so it lands last).
const letters = [
  'M74.82,26.1h6.56v35.3h-6.56V26.1Z',
  'M127.36,61.4l-.05-27.23-13.06,12.35h0l-13.06-12.4v27.28h-6.25V26.1h5.4l14.02,12.56,13.77-12.56h5.39l.05,35.3h-6.2Z',
