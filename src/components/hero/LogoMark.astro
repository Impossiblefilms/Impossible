const strikeLine = 'M22.5,47.02v-6.56h458.1v6.56H22.5Z';
---

<svg
  class:list={['logo-mark', className]}
  viewBox="0 0 502.83 87.49"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={label}
>
  {
    letters.map((d, i) => (
      <path class="logo-letter" style={`--i: ${i}`} d={d} fill="currentColor" />
    ))
  }
  <path class="logo-strike" d={strikeLine} fill="currentColor" />
</svg>

<style>
  .logo-mark {
    overflow: visible;
  }

  .logo-letter {
    opacity: 0;
    transform: translateY(0.4em);
    animation: letter-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 55ms);
  }

  .logo-strike {
    transform-box: fill-box;
    transform-origin: left center;
    transform: scaleX(0);
    animation: strike-in 0.7s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    animation-delay: 1.05s;
  }

  @keyframes letter-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes strike-in {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-letter,
    .logo-strike {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
