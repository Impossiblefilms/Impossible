  'M231.27,57.66l2.27-5.09c2.82,2.27,7.31,3.88,11.65,3.88,5.5,0,7.82-1.97,7.82-4.59,0-7.61-20.98-2.62-20.98-15.73,0-5.7,4.54-10.54,14.22-10.54,4.24,0,8.67,1.11,11.75,3.13l-2.07,5.09c-3.18-1.86-6.66-2.77-9.73-2.77-5.45,0-7.66,2.12-7.66,4.79,0,7.51,20.93,2.62,20.93,15.58,0,5.65-4.59,10.49-14.27,10.49-5.5,0-10.99-1.71-13.92-4.24Z',
