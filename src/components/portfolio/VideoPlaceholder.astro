---
import { Icon } from 'astro-icon/components';
import type { Project } from '../../lib/types';

interface Props {
  project: Project;
  // Grid cards show the static thumbnail (with a play affordance) and only
  // the project detail page actually loads the Vimeo embed — nine
  // autoplaying iframes on one page would be wasteful and slow.
  playEmbed?: boolean;
}

const { project, playEmbed = false } = Astro.props;
const canEmbed = playEmbed && Boolean(project.vimeoId);
const showThumbnail = !canEmbed && project.thumbnail;
---

<div class="relative aspect-video w-full overflow-hidden rounded-2xl bg-ink-900">
  {
    canEmbed ? (
      // Click-to-load facade: no request to vimeo.com (and no third-party
      // cookies) until the visitor actively chooses to watch — avoids
      // needing a cookie-consent gate just to view the page.
      <button
        type="button"
        class="vimeo-trigger group absolute inset-0 h-full w-full cursor-pointer"
        data-vimeo-id={project.vimeoId}
        data-title={project.title}
        aria-label={`${project.title} abspielen`}
      >
        {project.thumbnail && (
          <img
            src={project.thumbnail}
            alt={project.title}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        )}
        <span class="absolute inset-0 flex items-center justify-center bg-ink-950/25 transition-colors group-hover:bg-ink-950/40">
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-paper-50/90 text-ink-950 transition-transform group-hover:scale-110">
            <Icon name="lucide:play" class="ml-1 h-7 w-7" />
          </span>
        </span>
      </button>
    ) : showThumbnail ? (
      <img
        src={project.thumbnail}
        alt={project.title}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <div
        class="absolute inset-0 flex items-center justify-center px-4"
        style={`background-color: ${project.accentColor};`}
      >
        <span
          class="text-center font-display uppercase leading-[0.9] text-paper-50/90"
          style="font-size: clamp(1.25rem, 3.5vw, 2.5rem);"
        >
          {project.title}
        </span>
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.vimeo-trigger').forEach((trigger) => {
    trigger.addEventListener(
      'click',
      () => {
        const vimeoId = trigger.dataset.vimeoId;
        if (!vimeoId) return;

        const iframe = document.createElement('iframe');
        iframe.className = 'absolute inset-0 h-full w-full';
        iframe.src = `https://player.vimeo.com/video/${vimeoId}?title=0&byline=0&portrait=0&autoplay=1`;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = trigger.dataset.title ?? '';

        trigger.replaceWith(iframe);
      },
      { once: true }
    );
  });
</script>
